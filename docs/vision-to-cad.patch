+        return;
+      }
+      visSay(para(L('Job started. ', 'Job dimulai. ') + (j.scale_label || ''), 'm'));
+      if (j.fea_allowed === false) visSay(para(L('No strength check: the scale is provisional, so a safety factor would be a made-up number.',
+        'Tanpa cek kekuatan: skalanya sementara, jadi safety factor akan jadi angka karangan.'), 'm'));
+      visPoll(j.job_id);
+    })
+    .catch((e) => visSay(para(L('The solver did not answer: ', 'Solver tidak menjawab: ') + (e && e.message), 'm')));
+}
+function visPoll(id) {
+  clearInterval(VIS.timer);
+  const stage = para(L('Waiting for the design job…', 'Menunggu job desain…'), 'm');
+  visSay(stage);
+  VIS.timer = setInterval(async () => {
+    try {
+      const r = await fetch(API + '/design/job/' + encodeURIComponent(id));
+      const j = await r.json();
+      stage.textContent = `${j.status || '?'} · ${j.stage || ''} · ${j.elapsed_s != null ? j.elapsed_s + ' s' : ''}` +
+        (j.waiting_for ? ` · ${L('waiting for', 'menunggu')} ${j.waiting_for}` : '');
+      if (j.status === 'done' || j.status === 'failed') {
+        clearInterval(VIS.timer);
+        const res = j.result || {};
+        if (res.cad && typeof genFromAI === 'function') genFromAI(res.cad);
+        if (res.answer) visSay(para(res.answer));
+        else if (j.error) visSay(para(String(j.error), 'm'));
+        if (res.cad && (res.cad.steps || []).length) visSay(para(L('Build order: ', 'Urutan bangun: ') + res.cad.steps.map((s) => s.name).join(', '), 'm'));
+        if (res.label) visSay(para(L('Label: ', 'Label: ') + res.label, 'm'));
+      }
+    } catch (e) { /* keep waiting: the solver may be restarting */ }
+  }, 2000);
+}
+function visMasks(size) {
+  const n = size || 128, rows = [], ink = [], src = visSource();
+  try {
+    const c = viewer && viewer.canvas;
+    if (c) {
+      const o = document.createElement('canvas'); o.width = n; o.height = n;
+      const g = o.getContext('2d'); g.clearRect(0, 0, n, n); g.drawImage(c, 0, 0, n, n);
+      const d = g.getImageData(0, 0, n, n).data;
+      for (let y = 0; y < n; y++) { const row = []; for (let x = 0; x < n; x++) row.push(d[(y * n + x) * 4 + 3] > 16 ? 1 : 0); rows.push(row); }
+    }
+  } catch (e) { /* no model silhouette */ }
+  return { model: rows, src };
+}
+async function visShapeMatch() {
+  const { model, src } = visMasks(128);
+  if (!model.length) return visSay(para(L('Build the part first: the model silhouette comes from the viewport.', 'Bangun part dulu: siluet model diambil dari viewport.'), 'm'));
+  if (!src) return visSay(para(L('The picture is gone; read it again.', 'Gambarnya hilang; baca ulang.'), 'm'));
+  const img = await new Promise((res, rej) => { const i = new Image(); i.onload = () => res(i); i.onerror = rej; i.src = 'data:' + src.mime + ';base64,' + src.data; });
+  const n = 128, o = document.createElement('canvas'); o.width = n; o.height = n;
+  const g = o.getContext('2d'); g.fillStyle = '#fff'; g.fillRect(0, 0, n, n); g.drawImage(img, 0, 0, n, n);
+  const d = g.getImageData(0, 0, n, n).data, ink = [];
+  for (let y = 0; y < n; y++) {
+    const row = [];
+    for (let x = 0; x < n; x++) {
+      const i = (y * n + x) * 4;
+      const lum = 0.3 * d[i] + 0.59 * d[i + 1] + 0.11 * d[i + 2];
+      row.push(lum < VIS.inkThresh ? 1 : 0);
+    }
+    ink.push(row);
+  }
+  const r = await fetch(API + '/vision/similarity', { method: 'POST', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ model_silhouette: model, image_silhouette: ink, size: n }) });
+  const j = await r.json().catch(() => null);
+  if (!r.ok || !j || !j.success) return visSay(para((j && j.error) || ('HTTP ' + r.status), 'm'));
+  visSay(para(`Shape match: ${j.iou_percent}% (silhouette, ${n}px) · ${L('biggest difference', 'perbedaan terbesar')}: ${j.biggest_region ? `${j.biggest_region.w_percent}% x ${j.biggest_region.h_percent}%` : '—'}`),
+    para(L('This is a 2D silhouette comparison, not a 3D shape claim.', 'Ini perbandingan siluet 2D, bukan klaim bentuk 3D.'), 'm'));
+}
+(function visButton() {
+  try {
+    const head = document.querySelector('.phead');
+    if (!head || document.getElementById('visOpen')) return;
+    const b = h('button', { class: 'vistab', id: 'visOpen', title: L('Sketch / Photo to CAD', 'Sketsa / Foto ke CAD'),
+      onclick: () => visModal() }, L('Sketch / Photo', 'Sketsa / Foto'));
+    b.style.marginLeft = 'auto';
+    head.insertBefore(b, head.querySelector('.x'));
+  } catch (e) { /* the panel is not there yet */ }
+})();
+
+window.__idris = { state, parseText, viewer, frameFit, vis: { VIS, visModal, visShapeMatch } };
 })();
 </script>
 </body>
